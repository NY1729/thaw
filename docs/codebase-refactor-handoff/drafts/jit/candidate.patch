+#[no_mangle]
+/// Returns the physical presence state (0 hole, 1 value, 2 explicit
+/// undefined) for a compiler-owned two-word native array handle. The JIT
+/// installs this query only for that layout; standalone one-word handles
+/// use its dense fallback.
+///
+/// # Safety
+/// `handle` must point to a live `{buffer, presence}` native array handle.
+pub unsafe extern "C" fn thaw_jit_array_index_present(
+    handle: *const *const u8,
+    index: usize,
+) -> u8 {
+    if handle.is_null() { return 0; }
+    let buffer = unsafe { handle.read() };
+    let Some(length) = (unsafe { native_array_length(buffer) }) else { return 0; };
+    if index >= length { return 0; }
+    let presence = unsafe { handle.add(1).read() };
+    if presence.is_null() { return 1; }
+    let mask_len = unsafe { presence.cast::<u64>().read() as usize };
+    if index >= mask_len { return 1; }
+    unsafe { presence.add(8 + index).read() }
+}
