+        CallbackValueKind::Boolean
+    } else if token.starts_with('s') {
+        CallbackValueKind::String
+    } else if token.starts_with('h') {
+        CallbackValueKind::NativeHandle
+    } else if token.starts_with("rn") || token.starts_with("rb") || token.starts_with("rs") {
+        CallbackValueKind::ArrayReference
+    } else if token.starts_with("dn") || token.starts_with("db") || token.starts_with("ds") {
+        CallbackValueKind::DictionaryReference
+    } else if token.starts_with("en") || token.starts_with("eb") || token.starts_with("es") {
+        CallbackValueKind::Unknown
+    } else {
+        return None;
+    };
+    Some(CallbackSourceKind::Argument(kind))
+}
+
+fn local_source_kind(token: &str) -> Option<CallbackSourceKind> {
+    let kind = if token.starts_with("rnl") || token.starts_with("rbl") || token.starts_with("rsl") {
+        CallbackValueKind::ArrayReference
+    } else if token.starts_with("dnl") || token.starts_with("dbl") || token.starts_with("dsl") {
+        CallbackValueKind::DictionaryReference
+    } else if token.starts_with("ln") {
+        CallbackValueKind::Number
+    } else if token.starts_with("lb") {
+        CallbackValueKind::Boolean
+    } else if token.starts_with("ls") {
+        CallbackValueKind::String
+    } else if token.starts_with("ld") {
+        CallbackValueKind::Dynamic
+    } else {
+        return None;
+    };
+    Some(CallbackSourceKind::Local(kind))
+}
