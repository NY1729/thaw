+        (K::String, K::MaybeString) | (K::MaybeString, K::String) | (K::MaybeString, K::MaybeString) => K::MaybeString,
+        (K::Dynamic, K::MaybeDynamic) | (K::MaybeDynamic, K::Dynamic) | (K::MaybeDynamic, K::MaybeDynamic) => K::MaybeDynamic,
