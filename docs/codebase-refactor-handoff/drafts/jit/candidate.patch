+        ARENA_ALLOC.with(|slot| slot.set(old_allocate));
+        ARRAY_UNSHIFT.with(|slot| slot.set(old_unshift));
+        ARRAY_PUSH.with(|slot| slot.set(old_push));
+        ARRAY_INDEX_PRESENT.with(|slot| slot.set(old_query));
