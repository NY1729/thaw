+fn field_source_kind(token: &str, field_kind: u8) -> Option<CallbackSourceKind> {
+    if token.starts_with("objnullablen") {
+        return Some(CallbackSourceKind::Field(CallbackValueKind::Number));
+    }
+    let encoded = token
+        .strip_prefix("objnull")
+        .or_else(|| token.strip_prefix("objopt"))
+        .or_else(|| token.strip_prefix("obj"))
+        .or_else(|| token.strip_prefix("tupnull"))
