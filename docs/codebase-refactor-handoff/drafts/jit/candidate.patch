+            }
+            ("Object", "values", [object]) => Some(("dvalues", object.expr.as_ref(), None)),
+            ("Object", "entries", [object]) => Some(("dentries", object.expr.as_ref(), None)),
+            ("Object", "hasOwn", [object, key]) => Some((
+                "dhasown",
+                object.expr.as_ref(),
+                Some(key.expr.as_ref()),
