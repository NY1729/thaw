/// The locale's default hour cycle, as an ECMA-402 `hourCycle` value.
pub fn preferred_hour_cycle(locale: &str) -> Option<&'static str> {
    match locale {
        "en-US" => Some("h12"),
        "en-GB" => Some("h23"),
        "es" => Some("h23"),
        "es-419" => Some("h12"),
        "fr" => Some("h23"),
        "de" => Some("h23"),
        "it" => Some("h23"),
        "pt" => Some("h23"),
        "pt-BR" => Some("h23"),
        "nl" => Some("h23"),
        "sv" => Some("h23"),
        "pl" => Some("h23"),
        "ru" => Some("h23"),
        "uk" => Some("h23"),
        "tr" => Some("h23"),
        "ar" => Some("h12"),
        "ar-SA" => Some("h12"),
        "he" => Some("h23"),
        "hi" => Some("h12"),
        "bn" => Some("h12"),
        "ja" => Some("h23"),
        "ko" => Some("h12"),
        "zh-Hans" => Some("h23"),
        "zh-Hant" => Some("h12"),
        "th" => Some("h23"),
        "vi" => Some("h23"),
        "id" => Some("h23"),
        "ms" => Some("h12"),
        "fil" => Some("h12"),
        "el" => Some("h12"),
        "ro" => Some("h23"),
        "cs" => Some("h23"),
        "hu" => Some("h23"),
        "da" => Some("h23"),
        "fi" => Some("h23"),
        "nb" => Some("h23"),
        _ => None,
    }
}
