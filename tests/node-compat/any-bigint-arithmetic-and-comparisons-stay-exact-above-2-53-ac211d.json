{
  "name": "any BigInt arithmetic and comparisons stay exact above 2^53",
  "expect": "matched",
  "source": "function t(label: string, f: () => any): void {\n  try { console.log(label, f()); } catch (e: any) { console.log(label, 'ERR', e.name, e.message); }\n}\nfunction main(): void {\n  const a: any = BigInt(\"9007199254740993\");\n  const b: any = BigInt(\"3\");\n  const n: any = 10;\n  const m: any = 4;\n  t('a+b', () => a + b);\n  t('a-b', () => a - b);\n  t('a*b', () => a * b);\n  t('a/b', () => a / b);\n  t('a%b', () => a % b);\n  t('a**b', () => a ** b);\n  t('a>b', () => a > b);\n  t('a<b', () => a < b);\n  t('a>=a', () => a >= a);\n  t('a<=b', () => a <= b);\n  t('a<<b', () => a << b);\n  t('a>>b', () => a >> b);\n  t('a&b', () => a & b);\n  t('a|b', () => a | b);\n  t('a^b', () => a ^ b);\n  t('a-1n', () => a - 1n);\n  t('1n-a', () => 1n - a);\n  t('a*2n', () => a * 2n);\n  t('a<1n', () => a < 1n);\n  t('a-n', () => a - n);\n  t('n-a', () => n - a);\n  t('n-m', () => n - m);\n  t('n*m', () => n * m);\n  t('n/m', () => n / m);\n  t('n<m', () => n < m);\n  t('n**m', () => n ** m);\n  t('n<<m', () => n << m);\n  t('-a', () => -a);\n  t('-n', () => -n);\n  t('-0', () => -(n - n));\n}\n"
}
