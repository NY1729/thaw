+        functions.push(union_discard_expression_probe(
+            &format!("discard_{family_name}_plain_f64_some"),
+            vec![],
+            union_discard_some_value(
+                family,
+                HirExpr::Lit(HirLit::F64(f64::from_bits(0x0000_0000_0000_1234))),
