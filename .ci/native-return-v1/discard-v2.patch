+fn udjit_inject(value: HirExpr, tag: usize, members: &HirType) -> HirExpr {
+    let HirType::Union(members) = members else { panic!("expected union type") };
+    HirExpr::UnionInject(Box::new(value), tag, members.clone())
+}
