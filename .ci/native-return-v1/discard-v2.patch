+                            Box::new(HirExpr::UnionTag(
+                                Box::new(HirExpr::Var("borrowed_union".into())),
+                                flat_members.clone(),
+                            )),
+                            Box::new(HirExpr::Lit(HirLit::F64(0.0))),
+                        ),
+                        vec![HirStmt::Expr(HirExpr::UnionValue(
+                            Box::new(HirExpr::Var("borrowed_union".into())),
+                            0,
+                            flat_members,
+                        ))],
+                        vec![],
+                    ),
+                    HirStmt::Return(None),
