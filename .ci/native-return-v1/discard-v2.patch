+                vec![HirParam { name: "borrowed_promise".into(), ty: promise.clone() }],
+                HirType::Void,
+                vec![
+                    HirStmt::Expr(HirExpr::Var("borrowed_promise".into())),
+                    HirStmt::Return(None),
