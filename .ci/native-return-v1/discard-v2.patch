+fn union_discard_ir_store_pointer_operands(line: &str) -> Option<(String, String)> {
+    let rest = union_discard_ir_rhs(line).strip_prefix("store ptr ")?;
+    let (value, destination) = rest.split_once(", ptr ")?;
