+        for (selection, conditional) in [
+            ("owned_then_borrowed", HirExpr::Conditional(
+                Box::new(HirExpr::Var("choose_owned".into())),
+                Box::new(union_discard_call("owned_wrapper_promise")),
+                Box::new(HirExpr::Var("borrowed_promise".into())),
