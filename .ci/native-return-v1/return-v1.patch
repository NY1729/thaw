+                let params = if borrowed { vec![udjit_param("borrowed", promise.clone())] } else { Vec::new() };
+                functions.push(ner_named_return(
+                    &name,
+                    params,
+                    promise.clone(),
+                    udeval_eval_then(udjit_call(&first, Vec::new()), wrapped),
