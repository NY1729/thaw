+fn thaw_rethrow_cleanup_match_source_catch_pair<'a>(
+    pair: &'a [HirStmt],
+) -> Option<(&'a str, &'a [HirStmt])> {
+    let [
+        HirStmt::Let(
+            prelude_name,
+            prelude_type,
+            HirExpr::UnionInject(seed, 4, prelude_members),
+        ),
+        HirStmt::Try(_, catch_name, catch_body, _),
