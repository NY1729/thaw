+                    HirType::Object(fields) => HirType::Object(order(fields, declared_fields)?),
+                    other => other.clone(),
+                };
+                Some(HirExpr::Call(
+                    Box::new(HirExpr::Lambda(captures.clone(), params.clone(), ret, Box::new(body))),
+                    args.clone(),
+                ))
+            }
+            _ => None,
