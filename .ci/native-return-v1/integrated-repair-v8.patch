+    fn reorder_wrapped_accessor_literal(
+        value: &HirExpr,
+        declared_fields: &[(Symbol, HirType)],
+    ) -> Option<HirExpr> {
+        fn order<T: Clone>(
+            fields: &[(Symbol, T)],
+            declared_fields: &[(Symbol, HirType)],
+        ) -> Option<Vec<(Symbol, T)>> {
+            let mut ordered = Vec::with_capacity(fields.len());
